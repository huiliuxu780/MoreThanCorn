{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "business-platform://schemas/call-record-input/1.0",
  "title": "De-identified call record input (business analysis)",
  "type": "object",
  "additionalProperties": false,
  "required": ["sample_id", "call_id", "conversation"],
  "properties": {
    "sample_id": {"type": "string", "minLength": 1},
    "call_id": {"type": "string", "minLength": 1},
    "case_id": {"type": ["string", "null"]},
    "servicer_id": {"type": ["string", "null"]},
    "start_time": {"type": ["string", "null"], "format": "date-time"},
    "conversation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sequence", "speaker", "text"],
        "properties": {
          "sequence": {"type": "integer", "minimum": 0},
          "speaker": {
            "type": "string",
            "enum": ["customer", "agent", "system", "unknown"]
          },
          "text": {"type": "string"},
          "start_ms": {"type": ["integer", "null"], "minimum": 0},
          "end_ms": {"type": ["integer", "null"], "minimum": 0}
        }
      }
    },
    "product_context": {"type": ["object", "null"]}
  }
}
