{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "business-analysis AgentSpec",
  "type": "object", "additionalProperties": false,
  "required": ["id", "version", "name", "instructions", "questions", "tools"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "instructions": { "type": "string", "minLength": 1 },
    "questions": { "type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "text", "metric"],
      "properties": { "id": { "type": "string" }, "text": { "type": "string" },
        "metric": { "type": "string" }, "dimensions": { "type": "array", "items": { "type": "string" } } } } },
    "tools": { "type": "array", "items": { "type": "object", "additionalProperties": false,
      "required": ["name", "version"], "properties": { "name": { "type": "string" }, "version": { "type": "string" } } } },
    "master_data": { "type": "array" },
    "input_schema": { "type": "string" }, "output_schema": { "type": "string" },
    "model": { "type": "object", "additionalProperties": false, "required": ["provider", "model"],
      "properties": { "provider": { "type": "string" }, "model": { "type": "string" }, "parameters": { "type": "object" } } }
  }
}
