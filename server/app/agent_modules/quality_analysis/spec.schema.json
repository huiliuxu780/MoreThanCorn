{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "quality-analysis AgentSpec",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "name", "instructions", "criteria", "tools", "master_data"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "instructions": { "type": "string", "minLength": 1 },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "tool_policy"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "tool_policy": {
            "type": "string",
            "enum": ["forbidden", "knowledge_search", "business_fact_tools"]
          }
        }
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 }
        }
      }
    },
    "master_data": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 }
        }
      }
    },
    "input_schema": { "type": "string" },
    "output_schema": { "type": "string" },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model"],
      "properties": {
        "provider": { "type": "string", "enum": ["openai", "openai-compatible", "deepseek-compatible"] },
        "model": { "type": "string", "minLength": 1 },
        "parameters": { "type": "object" }
      }
    }
  }
}
