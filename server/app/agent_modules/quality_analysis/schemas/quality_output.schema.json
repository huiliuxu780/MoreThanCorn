{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quality-platform://schemas/quality-output/1.0",
  "title": "Quality Agent structured output",
  "type": "object",
  "additionalProperties": false,
  "required": ["sample_id", "findings", "labels", "summary"],
  "properties": {
    "sample_id": {"type": "string", "minLength": 1},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion", "status", "confidence", "reason", "evidence"],
        "properties": {
          "criterion": {
            "type": "string",
            "enum": ["abusive_language", "knowledge_accuracy", "promise_fulfillment"]
          },
          "status": {
            "type": "string",
            "enum": ["passed", "failed", "not_applicable", "insufficient_evidence"]
          },
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "reason": {"type": "string", "minLength": 1},
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source", "reference", "summary"],
              "properties": {
                "source": {"type": "string", "enum": ["conversation", "tool"]},
                "reference": {"type": "string", "minLength": 1},
                "summary": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service_type_code", "issue_codes"],
      "properties": {
        "service_type_code": {"type": ["string", "null"]},
        "issue_codes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "summary": {"type": "string"}
  }
}
