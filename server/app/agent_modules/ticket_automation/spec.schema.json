{ "$schema": "https://json-schema.org/draft/2020-12/schema", "title": "ticket-automation AgentSpec",
  "type": "object", "additionalProperties": false,
  "required": ["id", "version", "name", "instructions", "actions", "tools", "approvalPolicy"],
  "properties": {
    "id": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 }, "instructions": { "type": "string", "minLength": 1 },
    "actions": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false,
      "required": ["id", "tool", "effect", "requiresApproval"],
      "properties": { "id": { "type": "string" }, "tool": { "type": "string" },
        "effect": { "type": "string", "enum": ["read", "write-reversible", "write-irreversible"] },
        "requiresApproval": { "type": "boolean" } } } },
    "tools": { "type": "array", "items": { "type": "object", "additionalProperties": false,
      "required": ["name", "version"], "properties": { "name": { "type": "string" }, "version": { "type": "string" } } } },
    "approvalPolicy": { "type": "string", "enum": ["none", "high-risk", "all-write"] },
    "idempotencyPolicy": { "type": "string", "enum": ["platform-key"] },
    "compensationPolicy": { "type": "string", "enum": ["record", "auto"] },
    "master_data": { "type": "array" }, "input_schema": { "type": "string" }, "output_schema": { "type": "string" },
    "model": { "type": "object", "additionalProperties": false, "required": ["provider", "model"],
      "properties": { "provider": { "type": "string" }, "model": { "type": "string" }, "parameters": { "type": "object" } } } } }
