{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quality-platform://schemas/native-workflow-output/0.2",
  "title": "Native provider workflow result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sample_id",
    "consumer_needs",
    "knowledge_claims",
    "promises",
    "workflow",
    "summary"
  ],
  "properties": {
    "sample_id": {"type": "string", "minLength": 1},
    "consumer_needs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["need_id", "category", "description", "evidence_sequences"],
        "properties": {
          "need_id": {"type": "string", "minLength": 1},
          "category": {
            "type": "string",
            "enum": ["repair", "complaint", "policy_consultation", "appointment", "other"]
          },
          "description": {"type": "string", "minLength": 1},
          "evidence_sequences": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "integer", "minimum": 0},
            "uniqueItems": true
          }
        }
      }
    },
    "knowledge_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "claim", "status", "search_rounds", "evidence_refs", "reason"],
        "properties": {
          "claim_id": {"type": "string", "minLength": 1},
          "claim": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["accurate", "inaccurate", "insufficient_evidence"]},
          "search_rounds": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["query", "evidence_refs", "decisive"],
              "properties": {
                "query": {"type": "string", "minLength": 1},
                "evidence_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
                "decisive": {"type": "boolean"}
              }
            }
          },
          "evidence_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "promises": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["promise_id", "type", "commitment", "status", "tool", "evidence_refs", "reason"],
        "properties": {
          "promise_id": {"type": "string", "minLength": 1},
          "type": {"type": "string", "enum": ["ticket", "sms", "appointment"]},
          "commitment": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["fulfilled", "unfulfilled", "mismatched", "insufficient_evidence"]},
          "tool": {"type": "string", "enum": ["ticket_query", "sms_query", "appointment_query"]},
          "evidence_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage_order", "plans", "barrier_passed"],
      "properties": {
        "stage_order": {
          "type": "array",
          "items": {"type": "string", "enum": ["identify", "plan", "execute", "barrier", "synthesize"]}
        },
        "plans": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["plan_id", "kind", "subject_id", "status", "tool_policy"],
            "properties": {
              "plan_id": {"type": "string", "minLength": 1},
              "kind": {"type": "string", "enum": ["knowledge", "promise"]},
              "subject_id": {"type": "string", "minLength": 1},
              "status": {"type": "string", "enum": ["completed", "failed"]},
              "tool_policy": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": ["knowledge_search", "ticket_query", "sms_query", "appointment_query"]
                },
                "uniqueItems": true
              }
            }
          }
        },
        "barrier_passed": {"type": "boolean"}
      }
    },
    "summary": {"type": "string", "minLength": 1}
  }
}
