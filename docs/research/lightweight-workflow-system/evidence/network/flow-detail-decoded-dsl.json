     "apiDocument": {
      "summary": "获取文件夹元信息",
      "request": "{\n\t\"folderToken\":\"\"\n}",
      "method": "post",
      "apiCode": "Feishu-Plugin-Integrate_B1SkNjbUMMh3nWcKBAquvw",
      "languageExample": {
       "Java": "import java.nio.charset.Charset;\nimport org.apache.hc.client5.http.impl.classic.CloseableHttpClient;\nimport org.apache.hc.client5.http.impl.classic.HttpClients;\nimport org.apache.hc.core5.http.ClassicHttpRequest;\nimport org.apache.hc.core5.http.io.entity.EntityUtils;\nimport org.apache.hc.core5.http.io.entity.StringEntity;\nimport org.apache.hc.core5.http.io.support.ClassicRequestBuilder;\n\npublic class HttpClientMain {\n    public static void main(String args[]) throws Exception {\n        try (CloseableHttpClient httpclient = HttpClients.createDefault()) {\n            /**\n             * 设置post body\n             */\n            Map<String, Object> postBody = new HashMap<>();\n            postBody.put(\"Authorization\", \"Bearer {{access_token}}\");\n            postBody.put(\"folderToken\", \"defaultStr\");\n            /**\n             * 设置header\n             */\n            ClassicHttpRequest httpPost = ClassicRequestBuilder.post(\"https://{gateway.domain}/Feishu-Plugin-Integrate/open-apis/drive/explorer/v2/folder/folderToken/meta\")\n                    .setEntity(new StringEntity(JSON.toJSONString(postBody), Charset.forName(\"UTF-8\")))\n                    .addHeader(\"Content-Type\", \"application/json\")\n                    .addHeader(\"Authorization\", \"Basic R3Zpc0cyTVBWRXhPRE5BN25rcXM4UHpCWWoxcTEyMzIxMzIxMzIxMzp1WXRYU09xMXAxV00xZVI0NFZBbjEyMzIxMzIxMzIxMw==\")\n                    .build();\n            httpclient.execute(httpPost, response -> {\n                System.out.println(response.getCode() + \" \" + response.getReasonPhrase());\n                final String body = EntityUtils.toString(response.getEntity());\n                System.out.println(body);\n                return null;\n            });\n        }\n    }\n}",
       "CURL": "# {gateway.domain}替换为真实网关域名。\ncurl --location 'https://{gateway.domain}/Feishu-Plugin-Integrate/open-apis/drive/explorer/v2/folder/folderToken/meta' \\\n--header 'Authorization: Basic R3Zpc0cyTVBWRXhPRE5BN25rcXM4UHpCWWoxcTEyMzIxMzIxMzIxMzp1WXRYU09xMXAxV00xZVI0NFZBbjEyMzIxMzIxMzIxMw==' \\\n--header 'Content-Type: application/json' \\\n--data '{\n\t\"Authorization\":\"Bearer {{access_token}}\",\n\t\"folderToken\":\"defaultStr\"\n}'",
       "Python": "import json\nimport requests\n\nif __name__ == '__main__':\n    url = \"https://{gateway.domain}/Feishu-Plugin-Integrate/open-apis/drive/explorer/v2/folder/folderToken/meta\"\n    headers = {'Content-Type': 'application/json', 'Authorization': 'Basic R3Zpc0cyTVBWRXhPRE5BN25rcXM4UHpCWWoxcTEyMzIxMzIxMzIxMzp1WXRYU09xMXAxV00xZVI0NFZBbjEyMzIxMzIxMzIxMw=='}\n    requestData = {\n\t\"Authorization\":\"Bearer {{access_token}}\",\n\t\"folderToken\":\"defaultStr\"\n}\n    ret = requests.post(url, json=requestData, headers=headers)\n    print(ret.status_code)\n    if 200 == ret.status_code:\n        text = json.loads(ret.text)\n        print(text)"
      },
