{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morethancorn.local/schemas/workflow-definition/1.0",
  "title": "WorkflowDefinition",
  "description": "轻量 Workflow DSL v1.0（Designed，见 07-workflow-dsl.md）。Published Version 深拷贝本结构且不可变。",
  "type": "object",
  "required": ["schemaVersion", "workflow", "graph", "io"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "workflow": {
      "type": "object",
      "required": ["id", "name", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^wf_[0-9A-HJKMNP-TV-Z]{26}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "description": { "type": "string", "maxLength": 512 },
        "status": { "enum": ["draft", "testing", "published", "deprecated"] },
        "currentVersionId": { "type": ["string", "null"] },
        "draftRevision": { "type": "integer", "minimum": 1 }
      }
    },
    "graph": {
      "type": "object",
      "required": ["nodes", "edges"],
      "properties": {
        "nodes": { "type": "array", "items": { "$ref": "#/$defs/WorkflowNode" } },
        "edges": { "type": "array", "items": { "$ref": "#/$defs/WorkflowEdge" } }
      }
    },
    "io": {
      "type": "object",
      "required": ["inputSchema", "structuredOutputs"],
      "properties": {
        "inputSchema": { "type": "object", "description": "JSON Schema（draft 2020-12）描述 Start 输入" },
        "structuredOutputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["key", "schema"],
            "properties": {
              "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
              "schema": { "type": "object" }
            }
          }
        }
      }
    },
    "triggers": {
      "type": "object",
      "properties": {
        "manual": { "type": "boolean", "default": true },
        "api": { "type": "boolean", "default": true },
        "scheduleIds": { "type": "array", "items": { "type": "string" } }
      }
    },
    "ui": {
      "type": "object",
      "description": "UI-only 字段，校验与执行忽略",
      "properties": {
        "positions": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["x", "y"],
            "properties": { "x": { "type": "number" }, "y": { "type": "number" } }
          }
        },
        "viewport": {
          "type": "object",
          "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "zoom": { "type": "number" } }
        }
      }
    },
    "meta": {
      "type": "object",
      "properties": {
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string" },
        "versionNote": { "type": "string", "maxLength": 512 }
      }
    }
  },
  "$defs": {
    "WorkflowNode": {
      "type": "object",
      "required": ["id", "type", "name", "config"],
      "properties": {
        "id": { "type": "string", "pattern": "^n_[a-z0-9]{1,24}$" },
        "type": { "enum": ["input", "llm", "tool", "condition", "transform", "end", "create-record", "notification"] },
        "name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "config": { "type": "object", "description": "由 node_definition.schema 约束（schema 驱动 Inspector）" },
        "inputs": { "type": "array", "items": { "$ref": "#/$defs/InputBinding" } },
        "execution": {
          "type": "object",
          "properties": {
            "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 600000, "default": 60000 },
            "retries": { "type": "integer", "minimum": 0, "maximum": 3, "default": 0 },
            "onError": { "enum": ["fail", "skip"], "default": "fail" }
          }
        },
        "branches": { "type": "array", "items": { "type": "string" }, "description": "condition/router 出边 handle 名" }
      }
    },
    "InputBinding": {
      "type": "object",
      "required": ["name", "type", "source"],
      "properties": {
        "name": { "type": "string" },
        "type": { "enum": ["string", "number", "boolean", "object", "array", "datetime"] },
        "source": {
          "oneOf": [
            { "type": "object", "required": ["kind", "value"], "properties": { "kind": { "const": "fixed" }, "value": {} } },
            {
              "type": "object",
              "required": ["kind", "nodeId", "path"],
              "properties": {
                "kind": { "const": "upstream" },
                "nodeId": { "type": "string" },
                "path": { "type": "string", "description": "outputs.xxx 路径" }
              }
            },
            { "type": "object", "required": ["kind", "path"], "properties": { "kind": { "enum": ["input", "state", "system"] }, "path": { "type": "string" } } }
          ]
        }
      }
    },
    "WorkflowEdge": {
      "type": "object",
      "required": ["id", "source", "target"],
      "properties": {
        "id": { "type": "string" },
        "source": { "type": "string" },
        "sourceHandle": { "type": "string", "description": "条件分支 handle；普通边省略" },
        "target": { "type": "string" }
      }
    }
  }
}
